---
-
  hosts: all
  become: true
  user: vagrant

  vars:
    vagrantfile:
      box: "bento/debian-13"
      hostname: "devbox"
      memory: "2048"
      disk: "50GB"
      network:
        bridge: "en0: Ethernet"
        public_ip: "192.168.0.40"
        private_ip: "192.168.1.40"
      synced_folder:
        source: "/path/to/projects"
        target: "/var/www"
      port_forward:
          80: 8080
          3306: 33060
    system:
      timezone: "Europe/Bucharest"
      apt:
        packages: []
      php:
        version: "8.5"
        extensions: []
      mysql:
        version: "9.7-lts"
        databases: []
    vhosts:
      - name: project_1
        document_root: "/var/www/project_1/public"
        domains:
          - "project_1.localdev"
          - "api.project_1.localdev"
        ssl: true
      - name: project_2
        document_root: "/var/www/project_2/public"
        domains:
          - "project_2.localdev"
          - "api.project_2.localdev"
        ssl: false
        supervisor:
          project_root: "/var/www/project_2"
          commands:
            - name: queue
              command: php artisan queue:work --sleep=1 --daemon
              numprocs: 3
              stdout_logfile: "/var/www/project_2/storage/logs/supervisor.log"
  roles:
    - role: .provisioning/system
      vars:
        application_timezone: "{{system.timezone}}"
        apt_extra_packages: "{{system.apt.packages}}"
    - role: .provisioning/nginx
    - role: .provisioning/php
      vars:
        php_version: "{{system.php.version}}"
        php_extra_extensions: "{{system.php.extensions}}"
    - role: .provisioning/mysql
      vars:
        mysql_version: "{{system.mysql.version}}"
        mysql_databases: "{{system.mysql.databases}}"
    - role: .provisioning/vhosts
      tags: vhosts
